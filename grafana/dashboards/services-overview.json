{
  "uid": "services-overview",
  "title": "services-overview",
  "description": "Método RED (tráfego, erros e duração) de todos os serviços, com saturação de JVM, logs e os serviços Python.",
  "tags": [
    "services"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
